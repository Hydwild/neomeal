# Шаблон. Скопируй в keystore.properties и впиши свои значения.
# keystore.properties НЕ коммить в git (он в .gitignore).
#
# Keystore создаётся командой (один раз, храни файл и пароли надёжно):
# keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#         -validity 10000 -alias xiaup
storeFile=release.jks
storePassword=ЗАМЕНИ_НА_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=xiaup
keyPassword=ЗАМЕНИ_НА_ПАРОЛЬ_КЛЮЧА
