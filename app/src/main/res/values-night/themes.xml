<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NutriTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/gradient_start</item>
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:navigationBarColor">@color/nav_background</item>

        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
        <item name="chipStyle">@style/ChipStyle</item>
        <item name="switchStyle">@style/SwitchStyle</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/nav_background</item>
        <item name="itemIconTint">@color/text_secondary</item>
        <item name="itemTextColor">@color/text_secondary</item>
    </style>

    <style name="ChipStyle" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">#FFFFFF</item>
        <item name="chipBackgroundColor">@color/card_bg</item>
        <item name="chipStrokeColor">@color/color_accent</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
