<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You фон виджета (Android 12+): нейтральный тон с подмесом
    цвета обоев вместо фирменного фиолетового градиента.
    Применяется из WidgetTheme при включённой опции «Цвета из обоев».
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/system_neutral1_800"/>
    <corners android:radius="20dp"/>
    <stroke android:width="1dp" android:color="@android:color/system_neutral1_600"/>
</shape>
