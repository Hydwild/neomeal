<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/appCardBg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Фото продукта -->
        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_food_placeholder"
            android:background="@drawable/circle_bg"
            android:layout_marginEnd="12dp"/>

        <!-- Название, категория, макросы, советы -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextSecondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>

            <TextView
                android:id="@+id/tvMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextSecondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>

            <!-- Автосовет -->
            <TextView
                android:id="@+id/tvAutoTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_success"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <!-- Ручная пометка -->
            <TextView
                android:id="@+id/tvManualNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_warning"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:visibility="gone"/>

            <!-- Цена -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_accent"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Калории на 100г -->
        <TextView
            android:id="@+id/tvCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <!-- Кнопки: добавить + редактировать (БЕЗ УДАЛЕНИЯ) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Добавить в дневник -->
            <ImageButton
                android:id="@+id/btnAdd"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_add_circle"
                app:tint="@color/color_accent"
                android:contentDescription="Добавить в дневник"/>

            <!-- Редактировать -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit"
                app:tint="?attr/appTextSecondary"
                android:contentDescription="Редактировать"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
