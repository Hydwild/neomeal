<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etComboName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/combo_name_hint"
            android:textSize="15sp"
            android:inputType="textCapSentences"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/combo_ingredients"
            android:textColor="?attr/appTextPrimary"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <!-- Сюда добавляются строки ингредиентов -->
        <LinearLayout
            android:id="@+id/containerIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/combo_add_ingredient"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appTextSecondary"
            android:alpha="0.2"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Живой итог КБЖУ -->
        <TextView
            android:id="@+id/tvComboTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/combo_per100_note"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
