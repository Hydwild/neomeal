<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉"
        android:textSize="64sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ob_result_title"
        android:textColor="?attr/appTextPrimary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvResultHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ob_result_sub"
        android:textColor="?attr/appTextPrimary"
        android:textSize="14sp"
        android:alpha="0.75"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="28dp"/>

    <!-- Карточка нормы калорий -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/appCardBg"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔥" android:textSize="32sp" android:layout_marginEnd="16dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ob_result_cal" android:textColor="?attr/appTextPrimary"
                    android:textSize="13sp" android:alpha="0.7"/>
                <TextView android:id="@+id/tvResultCalories" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/lay_0_kcal"
                    android:textColor="@color/color_accent" android:textSize="26sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Карточка нормы воды -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/appCardBg"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💧" android:textSize="32sp" android:layout_marginEnd="16dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ob_result_water" android:textColor="?attr/appTextPrimary"
                    android:textSize="13sp" android:alpha="0.7"/>
                <TextView android:id="@+id/tvResultWater" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/lay_0_ml"
                    android:textColor="@color/color_water" android:textSize="26sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ob_result_note"
        android:textColor="?attr/appTextPrimary"
        android:textSize="12sp"
        android:alpha="0.6"
        android:gravity="center"/>

</LinearLayout>
