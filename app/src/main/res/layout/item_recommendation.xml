<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Иконка-кружок -->
    <TextView
        android:id="@+id/tvRecIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="🥗"
        android:textSize="18sp"
        android:background="@drawable/circle_bg"
        android:layout_marginEnd="12dp"/>

    <!-- Название + причина -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rec_product_ph"
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRecReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rec_reason_ph"
            android:textColor="?attr/appTextSecondary"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Граммы + калории -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvRecGrams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_100_g"
            android:textColor="@color/color_accent"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRecCal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_0_kcal"
            android:textColor="?attr/appTextSecondary"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
