<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок: стрелки + название месяца -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="?attr/appTextPrimary"
                android:contentDescription="Прошлый месяц"/>

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cal_month_ph"
                android:textColor="?attr/appTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                app:tint="?attr/appTextPrimary"
                android:contentDescription="Следующий месяц"/>
        </LinearLayout>

        <!-- Кнопка "Сегодня" -->
        <TextView
            android:id="@+id/btnToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/calendar_today"
            android:textColor="?attr/appTextPrimary"
            android:textSize="13sp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"/>

        <!-- Шапка дней недели -->
        <LinearLayout
            android:id="@+id/rowWeekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_mon"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_tue"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_wed"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_thu"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_fri"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_sat" android:textColor="@color/accent_orange"/>
            <TextView style="@style/CalendarWeekday" android:text="@string/wd_sun" android:textColor="@color/accent_orange"/>
        </LinearLayout>

        <!-- Контейнер для сетки дней (анимируется при смене месяца) -->
        <FrameLayout
            android:id="@+id/gridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <GridLayout
                android:id="@+id/gridDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:rowCount="6"/>
        </FrameLayout>

        <!-- Легенда -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/legend_green"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/cal_norm"
                android:textColor="?attr/appTextSecondary" android:textSize="11sp"
                android:layout_marginEnd="14dp"/>

            <View android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/legend_yellow"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/cal_close"
                android:textColor="?attr/appTextSecondary" android:textSize="11sp"
                android:layout_marginEnd="14dp"/>

            <View android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/legend_red"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/cal_miss"
                android:textColor="?attr/appTextSecondary" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Мини-чарт калорий за месяц -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/appCardBg"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="14dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_cal_month"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvMonthStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/accent_orange_deep"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <com.nutritrack.app.ui.custom.MonthChartView
                    android:id="@+id/monthChart"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Карточка деталей выбранного дня -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/appCardBg"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cal_today"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <!-- Калории прогресс -->
                <TextView
                    android:id="@+id/tvCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_cal_0_0"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <ProgressBar
                    android:id="@+id/pbCalories"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FF7043"
                    android:layout_marginBottom="14dp"/>

                <!-- БЖУ строка -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_protein"
                            android:textColor="?attr/appTextSecondary" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvProtein"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_0_g"
                            android:textColor="@color/color_success" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_fat"
                            android:textColor="?attr/appTextSecondary" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvFat"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_0_g"
                            android:textColor="@color/color_warning" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_carbs"
                            android:textColor="?attr/appTextSecondary" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvCarbs"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/lay_0_g"
                            android:textColor="@color/color_carbs" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Вода + вес -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvWater"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_water_0_0"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="14sp"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- Список съеденного -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_eaten_that_day"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/containerEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:id="@+id/tvEmptyEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cal_no_records"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="gone"/>

                <!-- Кнопка перехода в дневник -->
                <Button
                    android:id="@+id/btnOpenInDiary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/lay_open_diary"
                    android:textColor="?attr/appTextPrimary"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_gradient"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
