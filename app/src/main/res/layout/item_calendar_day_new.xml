<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="90dp"
    android:layout_height="160dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="8dp">

        <!-- Color dot -->
        <View android:id="@+id/viewIndicator"
            android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/circle_indicator"
            android:layout_marginBottom="4dp"/>

        <!-- Day name (Mon, Tue...) -->
        <TextView android:id="@+id/tvDayName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="11sp"/>

        <!-- Day number -->
        <TextView android:id="@+id/tvDayNum"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>

        <!-- Progress bar -->
        <ProgressBar android:id="@+id/progressDay"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="4dp"
            android:progressDrawable="@drawable/progress_calories"/>

        <!-- Calories consumed -->
        <TextView android:id="@+id/tvConsumed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="11sp"
            android:gravity="center" android:textStyle="bold"/>

        <!-- Deficit/surplus -->
        <TextView android:id="@+id/tvDeficit"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:gravity="center"
            android:layout_marginTop="2dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>