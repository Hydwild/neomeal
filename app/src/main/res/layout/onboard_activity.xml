<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/lay_activity_level" android:textColor="@color/white"
        android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/ob_activity_sub"
        android:textColor="@color/white" android:textSize="14sp"
        android:layout_marginBottom="20dp"/>

    <RadioGroup android:id="@+id/rgActivity" android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton android:id="@+id/rbSedentary2" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/lay_act_sedentary_full"
            android:textColor="@color/white" android:textSize="15sp"
            android:background="@drawable/radio_item_bg" android:button="@null"
            android:paddingStart="16dp" android:gravity="center_vertical"
            android:layout_marginBottom="8dp"/>

        <RadioButton android:id="@+id/rbLight2" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/lay_act_light_full"
            android:textColor="@color/white" android:textSize="15sp"
            android:background="@drawable/radio_item_bg" android:button="@null"
            android:paddingStart="16dp" android:gravity="center_vertical"
            android:layout_marginBottom="8dp"/>

        <RadioButton android:id="@+id/rbModerate2" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/lay_act_moderate_full"
            android:textColor="@color/white" android:textSize="15sp"
            android:background="@drawable/radio_item_bg" android:button="@null"
            android:paddingStart="16dp" android:gravity="center_vertical"
            android:layout_marginBottom="8dp" android:checked="true"/>

        <RadioButton android:id="@+id/rbActive2" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/lay_act_active_full"
            android:textColor="@color/white" android:textSize="15sp"
            android:background="@drawable/radio_item_bg" android:button="@null"
            android:paddingStart="16dp" android:gravity="center_vertical"
            android:layout_marginBottom="8dp"/>

        <RadioButton android:id="@+id/rbVeryActive2" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/lay_act_veryactive_full"
            android:textColor="@color/white" android:textSize="15sp"
            android:background="@drawable/radio_item_bg" android:button="@null"
            android:paddingStart="16dp" android:gravity="center_vertical"/>
    </RadioGroup>
</LinearLayout>