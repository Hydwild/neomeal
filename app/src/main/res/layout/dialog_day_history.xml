<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/appBottomSheetBg">

    <TextView
        android:id="@+id/tvDayDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDaySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextSecondary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_day_bg"
        android:padding="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lay_eaten_day"
        android:textColor="?attr/appTextPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvNoEntries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dh_no_records"
        android:textColor="?attr/appTextSecondary"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDayEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:nestedScrollingEnabled="true"/>

</LinearLayout>