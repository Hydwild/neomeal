<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_water_reminders"
            android:textColor="?attr/appTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp"/>

        <!-- Главный переключатель -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="?attr/appCardBg" app:cardCornerRadius="20dp" app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/rowEnable"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔔" android:textSize="22sp" android:layout_marginEnd="16dp"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/wr_remind" android:textColor="?attr/appTextPrimary" android:textSize="16sp"/>
                <Switch
                    android:id="@+id/switchWaterReminder"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="56dp" android:minHeight="32dp"
                    android:clickable="false" android:focusable="false"
                    android:textOn="" android:textOff=""/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Настройки (показываются когда включено) -->
        <LinearLayout
            android:id="@+id/layoutSettings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Интервал -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/wr_interval" android:textColor="?attr/appTextSecondary"
                android:textSize="11sp" android:letterSpacing="0.1"
                android:layout_marginStart="6dp" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/appCardBg" app:cardCornerRadius="20dp" app:cardElevation="0dp">

                <RadioGroup
                    android:id="@+id/rgInterval"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="8dp">

                    <RadioButton android:id="@+id/rb60"  android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="@string/wr_every_hour"
                        android:textColor="?attr/appTextPrimary" android:paddingStart="10dp"/>
                    <RadioButton android:id="@+id/rb90"  android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="@string/wr_every_15"
                        android:textColor="?attr/appTextPrimary" android:paddingStart="10dp"/>
                    <RadioButton android:id="@+id/rb120" android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="@string/wr_every_2"
                        android:textColor="?attr/appTextPrimary" android:paddingStart="10dp" android:checked="true"/>
                    <RadioButton android:id="@+id/rb180" android:layout_width="match_parent"
                        android:layout_height="52dp" android:text="@string/wr_every_3"
                        android:textColor="?attr/appTextPrimary" android:paddingStart="10dp"/>
                </RadioGroup>
            </androidx.cardview.widget.CardView>

            <!-- Время активности -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/wr_times" android:textColor="?attr/appTextSecondary"
                android:textSize="11sp" android:letterSpacing="0.1"
                android:layout_marginStart="6dp" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/appCardBg" app:cardCornerRadius="20dp" app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/rowStartTime"
                        android:layout_width="match_parent" android:layout_height="58dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/lay_start" android:textColor="?attr/appTextPrimary" android:textSize="15sp"/>
                        <TextView android:id="@+id/tvStartTime" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="09:00"
                            android:textColor="@color/color_accent" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#2A2342" android:layout_marginStart="18dp"/>

                    <LinearLayout android:id="@+id/rowEndTime"
                        android:layout_width="match_parent" android:layout_height="58dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/lay_end" android:textColor="?attr/appTextPrimary" android:textSize="15sp"/>
                        <TextView android:id="@+id/tvEndTime" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="21:00"
                            android:textColor="@color/color_accent" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Сколько напоминаний в день (инфо) -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/appTextSecondary" android:textSize="13sp"
                android:gravity="center" android:padding="12dp"/>

            <!-- Умное напоминание -->
            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="14dp" android:background="#22FFFFFF"/>

            <LinearLayout
                android:id="@+id/rowSmartWater"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="14dp" android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/smart_water_toggle"
                        android:textColor="?attr/appTextPrimary" android:textSize="15sp"/>
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/smart_water_toggle_desc"
                        android:textColor="?attr/appTextSecondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSmartWater"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Подсказка про батарею + кнопка -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/lay_notif_battery_warn"
                android:textColor="?attr/appTextSecondary" android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnBatterySettings"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/lay_battery_settings"
                android:textColor="?attr/appTextPrimary" android:textAllCaps="false"
                android:background="@drawable/btn_gradient"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
