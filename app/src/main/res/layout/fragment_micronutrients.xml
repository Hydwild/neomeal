<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMicroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/micro_title"
            android:textColor="?attr/appTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvMicroSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/micro_subtitle"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- Сообщение, когда нет данных за день -->
        <TextView
            android:id="@+id/tvMicroEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/micro_empty"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"/>

        <!-- Сюда фрагмент добавляет строки нутриентов -->
        <LinearLayout
            android:id="@+id/microContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/micro_card_bg"
            android:padding="16dp"/>

        <!-- Секция «Восполнить дефицит» -->
        <LinearLayout
            android:id="@+id/suggestBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/micro_card_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSuggestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/micro_suggest_title"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/micro_suggest_sub"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/suggestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/micro_disclaimer"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
