<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Затемняющая вуаль для читаемости текста на любом градиенте/фото -->
    <View
        android:id="@+id/backgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Контент на весь экран — проходит ПОД баром -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Стеклянный бар поверх контента, прижат к низу -->
    <com.nutritrack.app.ui.custom.GlassBottomNav
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp" />

    <!-- Плавающая кнопка «Назад» над таб-баром на второстепенных экранах -->
    <ImageButton
        android:id="@+id/btnGlobalBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="74dp"
        android:src="@drawable/ic_arrow_left"
        android:scaleType="centerInside"
        android:background="@drawable/bg_back_button"
        android:contentDescription="@string/c_back"
        android:visibility="gone"
        android:elevation="9dp" />

</FrameLayout>
