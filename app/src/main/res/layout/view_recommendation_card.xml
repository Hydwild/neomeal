<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRecommend"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок (главный совет) -->
        <TextView
            android:id="@+id/tvRecHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lay_left_0_kcal"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Пояснение -->
        <TextView
            android:id="@+id/tvRecDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"/>

        <!-- Заголовок списка рекомендаций -->
        <TextView
            android:id="@+id/tvRecListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_you_can_eat"
            android:textColor="@color/color_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <!-- Контейнер для карточек продуктов (заполняется кодом) -->
        <LinearLayout
            android:id="@+id/layoutRecItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
