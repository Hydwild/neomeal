<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="120dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/card_day_bg"
    android:layout_margin="4dp"
    android:padding="8dp">

    <View android:id="@+id/viewIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_indicator"
        android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextSecondary"
        android:textSize="11sp"/>

    <TextView android:id="@+id/tvDayNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextPrimary"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView android:id="@+id/tvCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextSecondary"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>
</LinearLayout>