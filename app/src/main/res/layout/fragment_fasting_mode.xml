<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_fast_mode"
            android:textColor="?attr/appTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fast_mode_sub"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- Карточка статуса/настройки периода -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/appCardBg"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Переключатель режима -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fast_mode_title"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvFastingState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fast_off"
                            android:textColor="?attr/appTextSecondary"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchFasting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Блок дат (виден когда включён) -->
                <LinearLayout
                    android:id="@+id/datesBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="14dp">

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#33FFFFFF" android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/rowStartDate"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="?android:attr/selectableItemBackground">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/fast_start" android:textColor="?attr/appTextSecondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvStartDate"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="?attr/appTextPrimary" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowEndDate"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:background="?android:attr/selectableItemBackground">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/fast_end" android:textColor="?attr/appTextSecondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvEndDate"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="?attr/appTextPrimary" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Напоминание -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/lay_remind_fast"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="14sp"/>
                        <Switch
                            android:id="@+id/switchFastingReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Счётчик дней (виден когда период активен) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A3A2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:gravity="center">
                <TextView android:id="@+id/tvCounterBig"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/fast_day_ph"
                    android:textColor="@color/color_success" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvCounterSub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/fast_left_ph"
                    android:textColor="?attr/appTextPrimary" android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Дисклеймер -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lay_fast_note"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="18dp"/>

        <!-- Постные блюда -->
        <TextView
            android:id="@+id/tvRecipesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_lenten"
            android:textColor="?attr/appTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/containerRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
