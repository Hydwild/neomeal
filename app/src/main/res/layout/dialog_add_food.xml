<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/appBottomSheetBg">

    <!-- Ручка перетаскивания (сигнал «шторку можно смахнуть») -->
    <View
        android:id="@+id/sheetHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/sheet_drag_handle"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Заголовок (закреплён сверху) -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/af_add_product"
        android:textColor="?attr/appTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/sheetHandle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Кнопка добавить (закреплена внизу) -->
    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_gradient"
        android:text="@string/af_add"
        android:textColor="?attr/appTextPrimary"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Поиск (закреплён над кнопкой добавить) -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/lay_search_product"
        android:background="@drawable/input_bg"
        android:textColor="?attr/appTextPrimary"
        android:textColorHint="?attr/appTextSecondary"
        android:padding="12dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnVoice"/>

    <ImageButton
        android:id="@+id/btnVoice"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:background="@drawable/input_bg"
        android:scaleType="centerInside"
        android:contentDescription="Голосовой ввод"
        app:tint="@color/color_accent"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/etSearch"/>



    <!-- Граммовка (над поиском) -->
    <LinearLayout
        android:id="@+id/layoutGrams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_round"
            android:src="@drawable/ic_minus"
            android:contentDescription="Уменьшить"/>

        <TextView
            android:id="@+id/tvGrams"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/lay_100_g"
            android:textColor="?attr/appTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/grams_clickable_bg"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>

        <ImageButton
            android:id="@+id/btnScan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сканировать штрихкод"/>

        <ImageButton
            android:id="@+id/btnPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_round"
            android:src="@drawable/ic_plus"
            android:contentDescription="Увеличить"/>
    </LinearLayout>

    <!-- Ряд быстрого доступа: недавние/частые + повторить вчера -->
    <HorizontalScrollView
        android:id="@+id/quickScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvSheetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/quickRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- Список продуктов: занимает всё место между быстрым доступом и граммовкой -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/quickScroll"
        app:layout_constraintBottom_toTopOf="@id/layoutGrams"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
