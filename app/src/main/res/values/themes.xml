<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NutriTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="switchStyle">@style/Widget.NeoMeal.Switch</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:navigationBarColor">#212121</item>

        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
        <item name="chipStyle">@style/ChipStyle</item>
        <item name="switchStyle">@style/SwitchStyle</item>
    </style>

    <!-- Варианты темы с разными шрифтами (применяются из MainActivity) -->
    <style name="Theme.NutriTrack.Inter">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAppearanceButton">@style/TextAppearance.Btn.Inter</item>
        <item name="materialButtonStyle">@style/Btn.Inter</item>
    </style>

    <style name="Theme.NutriTrack.Manrope">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="textAppearanceButton">@style/TextAppearance.Btn.Manrope</item>
        <item name="materialButtonStyle">@style/Btn.Manrope</item>
    </style>

    <style name="Theme.NutriTrack.Montserrat">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="textAppearanceButton">@style/TextAppearance.Btn.Montserrat</item>
        <item name="materialButtonStyle">@style/Btn.Montserrat</item>
    </style>

    <!-- textAppearance кнопок с нужным шрифтом -->
    <style name="TextAppearance.Btn.Inter" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Btn.Manrope" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Btn.Montserrat" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Стили кнопок с нужным шрифтом -->
    <style name="Btn.Inter" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
    <style name="Btn.Manrope" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>
    <style name="Btn.Montserrat" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/nav_glass_bg</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/NavActiveIndicator</item>
        <item name="itemRippleColor">#337C4DFF</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Мягкая подсветка активного раздела -->
    <style name="NavActiveIndicator">
        <item name="android:color">#332E2150</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">12dp</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
    </style>

    <style name="NavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/BottomSheetShapeStyle</item>
    </style>

    <style name="BottomSheetShapeStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeRoundedTop</item>
    </style>

    <style name="ShapeRoundedTop">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="ChipStyle" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">#212121</item>
        <item name="chipBackgroundColor">#F5F5F5</item>
        <item name="chipStrokeColor">@color/color_accent</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="SwitchStyle" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="colorPrimary">@color/color_primary</item>
    </style>

    <style name="WaterButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/color_water</item>
        <item name="strokeColor">@color/color_water</item>
    </style>

    <!-- Заставка (Android 12+ Splash Screen API) -->
    <style name="Theme.NutriTrack.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.NutriTrack</item>
    </style>
    <style name="Widget.NeoMeal.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>
</resources>